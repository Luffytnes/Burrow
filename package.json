{
  "name": "burrow",
  "private": true,
  "version": "0.2.0",
  "description": "macOS cleaning & maintenance toolbox built with Tauri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luffytnes/Burrow.git"
  },
  "bugs": "https://github.com/Luffytnes/Burrow/issues",
  "homepage": "https://github.com/Luffytnes/Burrow#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run format:check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "framer-motion": "^12.43.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
